# Customer.io Track API credentials — used ONLY by Netlify functions (server-side).
# Never expose these in the client bundle. Set them in:
#   Netlify dashboard → Site settings → Environment variables
# Local dev (with `netlify dev`):
#   cp .env.example .env       and fill in the real values

# Get these from: Customer.io dashboard → Settings → API and Webhook Credentials
# → Track API Keys → "+ Add Credential"
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=

# "us" → fly.customer.io / track.customer.io
# "eu" → fly-eu.customer.io / track-eu.customer.io
CUSTOMERIO_REGION=us
